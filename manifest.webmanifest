{
  "name": "terraPen Camera Plot",
  "short_name": "Camera Plot",
  "description": "Turn your phone camera into pen-plotter line art and save an SVG.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
